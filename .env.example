# Claude API
ANTHROPIC_API_KEY=

# Voyage AI embeddingy
VOYAGE_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Admin sekce
# ADMIN_EMAIL / ADMIN_PASSWORD slouží už JEN k založení prvního uživatele
# skriptem `node scripts/seed-admin-user.mjs`. Aplikace se za běhu přihlašuje
# proti tabulce `users` (migrace 014) — po seedu je můžeš z prostředí odstranit.
ADMIN_EMAIL=spravce@firma.cz
ADMIN_PASSWORD=
# Volitelné — jméno a příjmení prvního uživatele (default „Správce Kecala")
# ADMIN_FIRST_NAME=
# ADMIN_LAST_NAME=
# Podpisový klíč session cookie — dlouhý náhodný řetězec (např. `openssl rand -hex 32`).
# POVINNÝ; jeho změna odhlásí všechny přihlášené.
SESSION_SECRET=

# SSO / OIDC (volitelné — bez OIDC_ISSUER se firemní přihlášení vůbec nenabídne;
# přihlášení jménem a heslem funguje beze změny). Redirect URI zaregistrovaná
# u IdP musí být <origin>/api/auth/oidc/callback.
# Pro lokální test slouží `node scripts/mock-idp.mjs` (viz README).
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Název claimu se skupinami (default `groups`); mapuje se na job_roles.external_group
# OIDC_GROUPS_CLAIM=groups
# Základ redirect URI, když se origin requestu liší od veřejné adresy (proxy)
# OIDC_REDIRECT_BASE_URL=https://kecalo.example.com

# Model pro chat (volitelné — default claude-sonnet-4-6)
# CHAT_MODEL=claude-sonnet-4-6

# Shrnutí poptávek běží přes Mistral (@ai-sdk/mistral) — prototypový test
# (Varianta B, viz docs/plans/mistral_summary_experiment_plan.md).
# Klíč je povinný, aby shrnutí fungovalo; bez něj se lead uloží bez shrnutí.
MISTRAL_API_KEY=
# Model pro shrnutí poptávek (volitelné — default mistral-small-latest)
# SUMMARY_MODEL=mistral-small-latest

# GDPR — retenční úklid (docs/plans/gdpr_plan.md)
# Secret pro cron routu /api/cron/retention. Bez něj routa vrací 503 (raději
# vypnutý úklid než veřejná mazací routa). Na Vercelu ho posílá cron sám
# v hlavičce Authorization: Bearer <CRON_SECRET>.
# Vygeneruj např. `openssl rand -hex 32`.
CRON_SECRET=
# Klíč pro otisk kontaktu v auditní tabulce privacy_actions (HMAC-SHA256).
# Volitelný — bez něj se odvodí ze SESSION_SECRET. Pozor: jeho změna rozpojí
# otisky ve starých auditních záznamech (nové se s nimi nespárují).
# PRIVACY_HASH_SECRET=

# RAG parametry (výchozí hodnoty jsou předvyplněny)
TOP_K=5
SIMILARITY_THRESHOLD=0.35
LLM_TEMPERATURE=0.2

# Langfuse observabilita (volitelné — bez nich app funguje, jen se neloguje)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Cíl eval runneru (scripts/langfuse-eval.mjs) — nasazená URL Kecala
# KECALO_BASE_URL=https://kecalo.vercel.app
